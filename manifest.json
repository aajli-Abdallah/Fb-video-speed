{
  "manifest_version": 3,
  "name": "Facebook Video Speed Controller",
  "version": "3.0.2",
  "description": "Facebook video power suite: speed controller (0.25x-4x), audio booster up to 300%, PiP, frame screenshot, and smart profiles.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.facebook.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Facebook Video Speed"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
